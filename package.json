{
  "name": "christinacormie-frontend",
  "version": "1.0.0",
  "description": "Production-ready React dashboard foundation for Christina Cormie.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "node api.js && vite",
    "build": "node api.js && tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "node src/lib/testing/runTests.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "keywords": [
    "react",
    "vite",
    "dashboard"
  ],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@reduxjs/toolkit": "^2.13.0",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-redux": "^9.3.0",
    "react-router": "^8.4.0",
    "recharts": "^3.10.1",
    "socket.io-client": "^4.8.4",
    "sonner": "^2.0.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1"
  }
}
