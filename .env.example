VITE_API_BASE_URL=
VITE_SOCKET_URL=
VITE_ENABLE_MOCK_AUTH=false
# Temporary anonymous access to /discover, /feed, /community and /message only.
# Set to true intentionally for a review build; false/absent keeps them private.
# Vite reads this at build time. Backend authorization is unchanged.
VITE_ENABLE_PUBLIC_REVIEW=false
